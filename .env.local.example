# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git — it holds secrets.

# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# From platform.claude.com -> Settings -> API keys
# This one is server-side only — it must NOT start with NEXT_PUBLIC_,
# or it would be exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here
